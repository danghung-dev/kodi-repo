<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
  <addon id="plugin.video.familycinema" name="Family Cinema" version="0.2.5" provider-name="Family">
    <requires>
      <import addon="xbmc.python" version="3.0.1" />
      <import addon="script.module.pycryptodome" version="3.4.3" />
      <import addon="inputstream.adaptive" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
      <summary lang="vi_VN">Xem phim từ nhiều website trong một add-on</summary>
      <summary lang="en_GB">Browse several video websites in one add-on</summary>
      <description lang="vi_VN">Duyệt, tìm kiếm và xem phim gia đình trong một add-on.</description>
      <description lang="en_GB">Browse, search and watch family videos in one add-on.</description>
      <platform>all</platform>
      <license>All rights reserved</license>
      <language>vi</language>
    </extension>
  </addon>
  <addon id="repository.familycinema" name="Family Cinema Repository" version="1.0.0" provider-name="Family">
    <extension point="xbmc.addon.repository" name="Family Cinema Repository">
      <dir>
        <info compressed="false">https://raw.githubusercontent.com/danghung-dev/kodi-repo/main/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/danghung-dev/kodi-repo/main/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/danghung-dev/kodi-repo/main/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="vi_VN">Kho cập nhật tự động cho Family Cinema</summary>
      <summary lang="en_GB">Auto-update repository for Family Cinema</summary>
      <description lang="vi_VN">Cài kho này một lần để Kodi tự cập nhật add-on Family Cinema.</description>
      <description lang="en_GB">Install once so Kodi keeps the Family Cinema add-on up to date.</description>
      <platform>all</platform>
      <license>All rights reserved</license>
    </extension>
  </addon>
</addons>
